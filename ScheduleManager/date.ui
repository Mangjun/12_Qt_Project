   <string notr="true">
    QWidget#Date {
        background-color: #FFFFFF;
    }

    /* 뒤로가기 버튼 */
    QPushButton#backButton {
        border: none;
        background-color: transparent;
        color: #007AFF;
        font-size: 16px;
        font-weight: bold;
    }

    /* 날짜 네비게이션 버튼 */
    QPushButton#navButton {
        border: none;
        background-color: #F2F2F7;
        border-radius: 15px;
        color: #1C1C1E;
        font-weight: bold;
        min-width: 35px;
        min-height: 35px;
    }
    QPushButton#navButton:hover {
        background-color: #E5E5EA;
    }

    /* 날짜 표시 버튼 */
    QPushButton#dateDisplayButton {
        border: none;
        background-color: transparent;
        font-size: 28px;
        font-weight: bold;
        color: #1C1C1E;
        padding: 5px 10px;
    }

    /* 일정 리스트 뷰 */
    QListView#scheduleListView {
        background-color: #F2F2F7;
        border: none;
        border-radius: 20px;
        padding: 15px;
        outline: none;
        font-size: 15px;
    }
    QListView#scheduleListView::item {
        padding: 10px;
        border-bottom: 1px solid #E5E5EA;
    }
    QListView#scheduleListView::item:selected {
        background-color: #E5E5EA;
        color: #007AFF;
        border-radius: 10px;
    }

    /* 일정 추가 버튼 (파란색) */
    QPushButton#addScheduleButton {
        background-color: #007AFF;
        color: white;
        border: none;
        border-radius: 15px;
        font-size: 16px;
        font-weight: bold;
        padding: 15px;
    }
    QPushButton#addScheduleButton:pressed {
        background-color: #0051A8;
    }

    QLabel#subTitle {
        font-size: 13px;
        color: #8E8E93;
        font-weight: bold;
        text-transform: uppercase;
    }
   </string>
