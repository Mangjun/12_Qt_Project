   <string notr="true">
   QWidget#scheduleDetail {
       background-color: #FFFFFF;
   }

   /* 뒤로가기 버튼 */
   QPushButton#backButton {
       border: none;
       background-color: transparent;
       color: #007AFF;
       font-size: 16px;
       font-weight: bold;
   }

   /* 상단 타이틀 및 이동 버튼 */
   QLabel#titleLabel {
       font-size: 24px;
       font-weight: bold;
       color: #1C1C1E;
   }
   QPushButton#navButton {
       border: none;
       background-color: #F2F2F7;
       border-radius: 15px;
       color: #1C1C1E;
       font-weight: bold;
       min-width: 30px;
       min-height: 30px;
   }

   /* 날짜 표시 */
   QLabel#dateLabel {
       font-size: 16px;
       color: #8E8E93;
       margin-bottom: 10px;
   }

   /* 세부 사항 입력창 */
   QTextEdit#detailEdit {
       background-color: #F2F2F7;
       border: 1px solid #E5E5EA;
       border-radius: 15px;
       padding: 20px;
       font-size: 16px;
       line-height: 1.5;
       color: #1C1C1E;
   }
   QTextEdit#detailEdit:focus {
       border: 1px solid #007AFF;
       background-color: #FFFFFF;
   }

   /* 하단 저장 버튼 */
   QPushButton#saveButton {
       background-color: #007AFF;
       color: white;
       border: none;
       border-radius: 12px;
       font-size: 16px;
       font-weight: bold;
       padding: 15px;
   }

   /* 하단 삭제 버튼 */
   QPushButton#deleteButton {
       background-color: transparent;
       color: #FF3B30; /* 애플 시스템 레드 */
       border: 1px solid #FF3B30;
       border-radius: 12px;
       font-size: 16px;
       padding: 14px;
   }
   QPushButton#deleteButton:hover {
       background-color: #FFF2F2;
   }
