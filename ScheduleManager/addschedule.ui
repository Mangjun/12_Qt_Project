       color: white;
       border: none;
       border-radius: 12px;
       font-size: 15px;
       font-weight: bold;
       padding: 14px;
   }
   QPushButton#addButton:pressed {
       background-color: #0051A8;
   }

   /* 취소 버튼 */
   QPushButton#cancelButton {
       background-color: #E5E5EA;
       color: #1C1C1E;
       border: none;
       border-radius: 12px;
       font-size: 15px;
       padding: 14px;
   }
   QPushButton#cancelButton:hover {
