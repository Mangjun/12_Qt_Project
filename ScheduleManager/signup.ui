 <property name="styleSheet">
  <string notr="true">
   QDialog {
       background-color: #FFFFFF;
   }

   QLabel#titleLabel {
       font-size: 24px;
       font-weight: bold;
       color: #1C1C1E;
   }

   QLineEdit {
       background-color: #F2F2F7;
       border: 1px solid #E5E5EA;
       border-radius: 12px;
       padding: 12px;
       font-size: 14px;
       color: #1C1C1E;
   }
   QLineEdit:focus {
       border: 1px solid #007AFF;
       background-color: #FFFFFF;
   }

   /* 회원가입 버튼 */
   QPushButton#signupButton {
       background-color: #007AFF;
       color: white;
       border: none;
       border-radius: 12px;
       font-size: 15px;
       font-weight: bold;
       padding: 14px;
   }
   QPushButton#signupButton:pressed {
       background-color: #0051A8;
   }

   /* 취소 버튼 */
   QPushButton#cancelButton {
       background-color: #E5E5EA;
       color: #1C1C1E;
       border: none;
       border-radius: 12px;
       font-size: 15px;
       padding: 14px;
   }
   QPushButton#cancelButton:hover {
       background-color: #D1D1D6;
   }
  </string>
 </property>

